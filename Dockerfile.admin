# ---- Build stage: compila SOLO el panel de administración (admin) ----
FROM node:20-alpine AS build
WORKDIR /app

# Dependencias (aprovecha la caché de Docker)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Código fuente
COPY . .

# Compilar solo admin en producción
RUN npm run generate-version && \
    npx ng build admin --configuration=production

# ---- Serve stage: nginx sirve el admin ----
FROM nginx:alpine

# Config de nginx (SPA: redirige rutas a index.html)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Dist del admin directamente en el html de nginx
COPY --from=build /app/dist/admin /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
